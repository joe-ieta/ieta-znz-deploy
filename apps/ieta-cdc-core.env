APP_ID=ieta-cdc-core
APP_NAME=IETA CDC Core
CAPABILITIES=postgres,mysql,es7,flink
REQUIRED_SERVICES=postgres,mysql8,es7-cdc,flink-jobmanager,flink-taskmanager
CONTAINER_NETWORK=ieta-znz-deploy
HOST_ENV_TEMPLATE=project-env/ieta-cdc-core.host.env
CONTAINER_ENV_TEMPLATE=project-env/ieta-cdc-core.env
# Declared total Flink slots for capacity-gate review; must equal .env FLINK_TASK_SLOTS * FLINK_TM_REPLICAS
FLINK_TOTAL_SLOTS=21
# Host-side readiness probes: <port-var>:<tcp|http>[/path]. Ports are read from .env (single source of truth).
HOST_PROBES=POSTGRES_PORT:tcp,ES7_CDC_PORT:http:/,FLINK_REST_PORT:http:/overview
# .env port variable -> host env template key (key may be a URL; its port is extracted)
HOST_PORT_MAP=POSTGRES_PORT=POSTGRES_PORT,MYSQL_PORT=MYSQL_PORT,ES7_CDC_PORT=ELASTICSEARCH7_URL,FLINK_REST_PORT=FLINK_REST_URL
NOTES=CDC uses PostgreSQL metadata, MySQL with binlog, Elasticsearch 7, and Flink. Flink connector jars and runner upload remain application release responsibilities. ES7 auth (no TLS) and Flink slot/memory sizing are controlled from the root .env.
