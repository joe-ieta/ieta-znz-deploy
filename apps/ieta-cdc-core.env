APP_ID=ieta-cdc-core
APP_NAME=IETA CDC Core
CAPABILITIES=postgres,mysql,es7,flink
REQUIRED_SERVICES=postgres,mysql8,es7-cdc,flink-jobmanager,flink-taskmanager
CONTAINER_NETWORK=ieta-znz-deploy
HOST_ENV_TEMPLATE=project-env/ieta-cdc-core.host.env
CONTAINER_ENV_TEMPLATE=project-env/ieta-cdc-core.env
FLINK_TOTAL_SLOTS=63
HOST_PROBES=POSTGRES_PORT:tcp,ES7_CDC_PORT:http:/,FLINK_REST_PORT:http:/overview
NOTES=CDC uses PostgreSQL metadata, MySQL with binlog, Elasticsearch 7, and Flink. FLINK_TOTAL_SLOTS must match .env FLINK_TASK_SLOTS x FLINK_TM_REPLICAS (21 x 3 = 63 by default) so consumers can verify the CDC Core capacity gate (minimum-flink-free-slots=20, requires slots-available >= 21 per submission). HOST_PROBES drives the host port checks in status-app-base.sh. Flink connector jars and runner upload remain application release responsibilities.
