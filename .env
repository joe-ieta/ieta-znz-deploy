# IETA shared base environment. Change passwords before non-local deployment.
COMPOSE_PROJECT_NAME=ieta-znz-deploy

# Shared network and common credentials
IETA_ZNZ_DEPLOY_NETWORK=ieta-znz-deploy
POSTGRES_PASSWORD=pg
MYSQL_ROOT_PASSWORD=infini_rag_flow
MYSQL_APP_PASSWORD=infini_rag_flow
MINIO_ROOT_USER=ieta_admin
MINIO_ROOT_PASSWORD=infini_rag_flow
VALKEY_PASSWORD=infini_rag_flow
ELASTIC_PASSWORD=infini_rag_flow
ONLYOFFICE_JWT_SECRET=ieta_onlyoffice_secret

# Host ports for host-run development
POSTGRES_PORT=15432
MYSQL_PORT=3306
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
VALKEY_PORT=6379
ES8_RAGFLOW_PORT=1200
ES7_CDC_PORT=19200
FLINK_REST_PORT=19081
ONLYOFFICE_PORT=8088

# Resource sizing
ES8_MEM_LIMIT=8073741824
ES7_MEM_LIMIT=2147483648

# Flink capacity (CDC Core default capacity gate requires slots-available >= 21)
# Total slots = FLINK_TASK_SLOTS * FLINK_TM_REPLICAS. Production 200-job phase needs >= 221 total slots,
# e.g. FLINK_TASK_SLOTS=20 FLINK_TM_REPLICAS=12, started with:
#   docker compose --project-name ieta-znz-deploy -f docker-compose.ieta-znz-deploy.yml \
#     --profile flink up -d --scale flink-taskmanager=12
FLINK_TASK_SLOTS=21
FLINK_TM_REPLICAS=1
FLINK_JM_MEMORY=2g
FLINK_TM_MEMORY=5g

# Optional Elasticsearch 7 security (auth only, no TLS transport encryption)
ES7_SECURITY_ENABLED=false

# Optional least-privilege PostgreSQL accounts for CDC Core. Leave empty to skip
# init/postgres/02-cdc-roles.sh (roles are created only on first volume init).
IETA_CORE_PASSWORD=
IETA_CDC_WRITER_PASSWORD=
IETA_CDC_OPS_PASSWORD=
