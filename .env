# IETA shared base environment. Change passwords before non-local deployment.
COMPOSE_PROJECT_NAME=ieta-znz-deploy

# Shared network and common credentials
IETA_ZNZ_DEPLOY_NETWORK=ieta-znz-deploy
POSTGRES_PASSWORD=pg
MYSQL_ROOT_PASSWORD=infini_rag_flow
MYSQL_APP_PASSWORD=infini_rag_flow
MINIO_ROOT_USER=ieta_admin
MINIO_ROOT_PASSWORD=infini_rag_flow
VALKEY_PASSWORD=infini_rag_flow
ELASTIC_PASSWORD=infini_rag_flow
ONLYOFFICE_JWT_SECRET=ieta_onlyoffice_secret

# Host ports for host-run development
POSTGRES_PORT=15432
MYSQL_PORT=3306
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
VALKEY_PORT=6379
ES8_RAGFLOW_PORT=1200
ES7_CDC_PORT=19200
FLINK_REST_PORT=19081
ONLYOFFICE_PORT=8088
LLAMA_CPP_PORT=18080
VLLM_PORT=18000

# Resource sizing
ES8_MEM_LIMIT=8073741824
ES7_MEM_LIMIT=2147483648

# Flink sizing. CDC Core capacity gate sync.cdc.capacity.minimum-flink-free-slots=20
# requires at least 21 available slots per task submission, so the default keeps
# FLINK_TASK_SLOTS >= 21. FLINK_TOTAL_SLOTS = FLINK_TASK_SLOTS x FLINK_TM_REPLICAS.
# Small resource-limited environments may set FLINK_TM_REPLICAS=1 explicitly; see
# the operations guide for the single-TaskManager fault domain impact.
FLINK_TASK_SLOTS=21
FLINK_TM_REPLICAS=3
FLINK_JM_MEM=1600m
FLINK_TM_MEM=4g

# Flink JM metaspace and checkpointing (CDC Core R2-EXT). Application-mode adds a classloader
# per submitted job: budget ~2-4MB metaspace per job (40 concurrent jobs verified to need 1g),
# so the default stays >= 512m. Checkpoint/restart keys follow the CDC Core Green installer
# baseline; checkpoints live on the flink_checkpoints named volume (see operations guide).
FLINK_JM_METASPACE=1g
FLINK_CK_INTERVAL=60s

# Elasticsearch 7 optional authentication. No TLS transport encryption; enable only
# inside a trusted network and keep the TLS boundary documented in the operations guide.
ES7_SECURITY_ENABLED=false

# LLM model paths inside ./models. These services are profile-gated and not started by default.
LLAMA_CPP_MODEL=/models/model.gguf
VLLM_MODEL=/models/model
